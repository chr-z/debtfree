{
  "name": "debtfree",
  "version": "2.0.0",
  "description": "Snowball & avalanche debt payoff planner with month-by-month chart. Built with Svelte 5 (runes). Free, private, offline-first PWA.",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "keywords": [
    "debt",
    "snowball",
    "avalanche",
    "payoff-planner",
    "personal-finance",
    "pwa",
    "i18n",
    "svelte"
  ],
  "author": "chr-z",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tsconfig/svelte": "^5.0.4",
    "svelte": "^5.28.0",
    "typescript": "~5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.8"
  }
}
